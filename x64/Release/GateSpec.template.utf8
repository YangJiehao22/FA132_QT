; GateSpec.ini - 与 DtSample.exe 同目录
; 可在「规格设定」对话框修改，也可直接编辑本文件（分号开头为注释行）

[timing]
; LightTest 开流后等待多久再采样(毫秒)，建议>=2000，等图像/电流稳定
DelayMs={{DELAY_MS}}

[limits]
; 各 Dev/VC 默认共用：Sensor 帧率、电流(mA)、芯片温度(C) 合格范围
MinSsrFps={{MIN_SSR_FPS}}
MaxSsrFps={{MAX_SSR_FPS}}
MinCurrent_mA={{MIN_CUR_MA}}
MaxCurrent_mA={{MAX_CUR_MA}}
MinSensorTemp_C={{MIN_TEMP_C}}
MaxSensorTemp_C={{MAX_TEMP_C}}

[sensor_temp_i2c]
; 温度公式 Temp(C)=(b0*CoeffLow+b1*CoeffHigh)/Divisor+Offset，b0/b1 来自 RegLow/RegHigh
; Enabled=1 时 LightTest 读 I2C 温度并参与判定
Enabled={{TEMP_EN}}
; I2C 从机地址(十六进制)
I2cAddr={{TEMP_ADDR}}
; I2C 读写模式(与 SDK carReadSensorI2c 一致)
I2cMode={{TEMP_MODE}}
; 温度寄存器地址(十六进制)，RegHigh=0 表示只读单字节
RegLow={{TEMP_REGLO}}
RegHigh={{TEMP_REGHI}}
CoeffLow={{TEMP_COEFFLO}}
CoeffHigh={{TEMP_COEFFHI}}
Divisor={{TEMP_DIV}}
Offset={{TEMP_OFF}}

[sensor_temp_i2c_vc]
; FA132 每路 Sensor I2C 从机地址 D{0..7}_V{0..3}（光测温度 + 烧录/SensorID 共用；须配合 UseMipiVcForBurn=1）
D0_V0=0x34
D0_V1=0x84
D0_V2=0x86
D0_V3=0x88
D1_V0=0x34
D1_V1=0x84
D1_V2=0x86
D1_V3=0x88
D2_V0=0x34
D2_V1=0x84
D2_V2=0x86
D2_V3=0x88
D3_V0=0x34
D3_V1=0x84
D3_V2=0x86
D3_V3=0x88
D4_V0=0x34
D4_V1=0x84
D4_V2=0x86
D4_V3=0x88
D5_V0=0x34
D5_V1=0x84
D5_V2=0x86
D5_V3=0x88
D6_V0=0x34
D6_V1=0x84
D6_V2=0x86
D6_V3=0x88
D7_V0=0x34
D7_V1=0x84
D7_V2=0x86
D7_V3=0x88

[bad_pixel_dark]
; 黑场亮坏点检测：须在暗场下测试(盖镜头/暗箱)，在 LightTest 延时后执行
; Enabled=1 开启；=0 关闭(不报 BadPx)
Enabled={{BP_EN}}
; AlgoMode: 0=8邻域简单算法  1=华为分通道算法(推荐，要求中心10% ROI均值<=50)
AlgoMode={{BP_ALGO}}
; BayerPattern: -1=自动(SDK/传感器ini)  0=RGGB 1=GRBG 2=GBRG 3=BGGR(08B等常为3)
BayerPattern={{BP_BAYER}}
; MaxBadPixels: 华为=每颜色通道允许亮点簇个数上限；8邻域=热点总数上限
MaxBadPixels={{BP_MAX}}
; HotDelta: 华为=单伤阈值|像素-全图均值|；8邻域=相对8邻域均值的增量
HotDelta={{BP_HOTDELTA}}
; BrightContrastCluster: 华为亮点群(簇)阈值，0=与 HotDelta 相同
BrightContrastCluster={{BP_CL_TH}}
; ClusterMinPixels: 华为判定为簇的最少像素数(连通域>=此值才计1簇)
ClusterMinPixels={{BP_CL_MIN}}
; SingleDefectPermyriad: 华为单伤上限，单位=个/10万像素(如1表示约每100万像素允许1个单伤)
SingleDefectPermyriad={{BP_PPM}}
; GrGbToG: 华为是否将 Gr+Gb 合并为 G 通道统计(1=合并 0=R/Gr/Gb/B 四通道)
GrGbToG={{BP_GRGB}}
; HotAbsMin: 8邻域专用，像素灰度绝对下限(低于此不判热点)
HotAbsMin={{BP_ABS}}
; BorderPx: 8邻域专用，图像四边忽略宽度(像素)
BorderPx={{BP_BORDER}}
; SaveSnapshot: 1=PASS与FAIL均抓图；0=不保存
SaveSnapshot={{BP_SAVE}}
; SaveBmp/SavePackedRaw/SaveUnpack12/SaveUnpack10: 勾选才保存对应文件
SaveBmp={{BP_SAVE_BMP}}
SavePackedRaw={{BP_SAVE_PACKED}}
SaveUnpack12={{BP_SAVE_U12}}
SaveUnpack10={{BP_SAVE_U10}}
; SaveDir: 抓图与 CSV 根目录，留空则使用 exe\log\LightTest\
SaveDir={{BP_DIR}}

[firmware_burn]
; Sony ISX031：bin 路径 exe\{FlashDataDir}\031{FovType}.bin（512KB）。须先 Open 再 Start
; ---------- 总开关 ----------
; Enabled：是否执行 Flash 烧录。=1 写 bin；=0 不烧录（可单独开 VerifyEnabled 只做校验）
Enabled={{FW_EN}}
; VerifyEnabled：是否做 14 寄存器标定校验（与 Enabled 无关）。=1 须 Open+Start
VerifyEnabled={{FW_VERIFY_EN}}
; VerifyBeforeGrab：=0 抓图 InitGrab 后读寄存器（推荐）；=1 仅 InitPower 读（易找不到从机）
VerifyBeforeGrab={{FW_VERIFY_BEFORE_GRAB}}
; ReadSensorIdEnabled：烧录前是否读 SensorID（0x7E80×10）。=0 跳过
ReadSensorIdEnabled={{FW_READ_SENSOR_ID}}
; ---------- 固件文件 ----------
; FovType：RABOB065200 | RABOM826200 | RABOM826100 | RABOM82660Flip | RABOM82660
FovType={{FW_FOV_TYPE}}
; FovTypeIndex：型号序号 0~4，若已写 FovType 字符串则以 FovType 为准
FovTypeIndex={{FW_FOV_INDEX}}
; FlashDataDir：bin 相对 exe 子目录
FlashDataDir={{FW_FLASH_DIR}}
; ---------- 时序（毫秒） ----------
; FwWarmupMs：仅烧录：Prep 完成后、写 Flash 前等待；校验/光测用 [timing] DelayMs
FwWarmupMs={{FW_WARMUP_MS}}
; PostBurnDelayMs：保留；校验前等待已用 [timing] DelayMs
PostBurnDelayMs={{FW_POST_BURN_MS}}
; ---------- I2C / 从机 ----------
; I2cRateKbps：烧录/校验前 I2C 速率(kHz)
I2cRateKbps={{FW_I2C_RATE}}
; AutoDetectSlave：未配 D#_V# 时是否扫 0x36/0x34；多 VC 建议 0，用 [sensor_temp_i2c_vc]
AutoDetectSlave={{FW_AUTO_SLAVE}}
; UseMipiVcForBurn：=1 每路烧录/校验前 SetMipiImageVC；FA132 须 1
UseMipiVcForBurn={{FW_USE_MIPI_VC}}
; ---------- FA132 双芯片 carSetChipID ----------
; Fa132DualChip：=1 按 VC 切芯片；烧录/校验先 Chip0 并行再 Chip1 并行
Fa132DualChip={{FW_FA132_DUAL_CHIP}}
; DualChipVcSplit：分界 VC，默认 2→VC0/1 第一颗，VC2/3 第二颗
DualChipVcSplit={{FW_DUAL_CHIP_VC_SPLIT}}
; ---------- 烧录后流程 ----------
; PowerCycleAfter：=1 且 Enabled=1 烧录后断电上电再校验；仅校验时不断电
PowerCycleAfter={{FW_POWER_CYCLE}}

[tcp_notify]
; TCP Client: after all VC tests + Production_report.csv, one Play cmd {"Order":"Play","SNList":[]}\n
Enabled={{TCP_EN}}
PeerHost={{TCP_HOST}}
PeerPort={{TCP_PORT}}
; OnlyOnOverallOk=1: send only when overall PASS
OnlyOnOverallOk={{TCP_ONLY_OK}}
ConnectTimeoutMs={{TCP_CONN_MS}}
SendTimeoutMs={{TCP_SEND_MS}}
WaitResponse={{TCP_WAIT_RESP}}
RecvTimeoutMs={{TCP_RECV_MS}}
RetryCount={{TCP_RETRY}}
